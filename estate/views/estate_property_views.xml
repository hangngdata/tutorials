<?xml version="1.0"?>
<odoo>
    <!-- Search View -->
    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">Real Estate Property Search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" string="Title"/>
                <field name="postcode"/>
                <field name="expected_price"/>
                <field name="bedrooms"/>
                <field name="living_area"/>
                <field name="facades"/>
                <filter string="Available" name="state" domain="['|', ('state', '=', 'new'), ('state', '=', 'offer_received')]"/>
            </search>
        </field>
    </record>

    <!-- List View -->
    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">Real Estate Property List</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Properties">
                <field name="name"/>
                <field name="postcode"/>
                <field name="bedrooms"/>
                <field name="living_area" string="Living Area (sqm)"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
                <field name="date_availability" string="Available From"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="estate_property_kanban_view" model="ir.ui.view">
        <field name="name">Real Estate Property Kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban string="Properties" default_group_by="property_type_id">
                <templates>
                    <t t-name="card">
                        <div>
                            <h2><field name="name"/></h2>
                            <div> Expected Price: <field name="expected_price"/></div>
                            <div t-if="record.state == 'offer_received'"> Best Offer: <field name="best_price"/></div>
                            <div>Selling Price: <field name="selling_price"/></div>
                            <div><field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Form View -->
    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">Estate Property Form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_sold" type="object" string="Sold" invisible="state in ['offer_accepted', 'sold', 'cancelled']"/>
                    <button name="action_set_sold" type="object" string="Sold" class="btn btn-success" invisible="state in ['new', 'offer_received', 'sold', 'cancelled']"/>
                    <button name="action_set_cancelled" type="object" string="Cancel" invisible="state in ['sold', 'cancelled']"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                    <group>
                        <group>
                            <field name="state" string="Status"/>
                            <field name="property_type_id" label="Property Type"/>
                            <field name="postcode"/>
                            <field name="date_availability" label="Available From"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price" string="Best Offer"/>
                            <field name="selling_price"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <group>
                                <field name="description" string="Description"/>
                                <field name="bedrooms" string="Bedrooms"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades" string="Facades"/>
                                <field name="garden" string="Garden"/>
                                <field name="garden_area" string="Garden Area" invisible="not garden"/>
                                <field name="garden_orientation" string="Garden Orientation" invisible="not garden"/>
                                <field name="state" string="Status" />
                                <field name="total" string="Total Area (sqm)"/>
                            </group>
                        </page>
                        <page string="Offers">
                             <field name="offer_ids" readonly="state in ['sold', 'offer_accepted', 'cancelled']"/>
                        </page>
                        <page string="Other info">
                            <group>
                                <field name="salesperson" string="Salesman"/>
                                <field name="buyer" string="Buyer"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban</field>
        <field name="view_ids" 
            eval="[
                (5, 0, 0), 
                (0, 0, {'view_mode': 'list', 'view_id': ref('estate_property_list_view')}), 
                (0, 0, {'view_mode': 'form', 'view_id': ref('estate_property_form_view')}),
                (0, 0, {'view_mode': 'kanban', 'view_id': ref('estate_property_kanban_view')})
                ]"/>
    </record>
</odoo>