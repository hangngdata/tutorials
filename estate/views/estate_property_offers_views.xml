<?xml version="1.0"?>
<odoo>
    <!-- List View -->
    <record id="estate_property_offer_list_view" model="ir.ui.view">
        <field name="name">Real Estate Property Offer List</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Name">
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <button name="action_accept" string="" type="object" icon="fa-check" invisible="status in ['accepted', 'refused']"/>
                <button name="action_refuse" string="" type="object" icon="fa-times" invisible="status in ['accepted', 'refused']"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="estate_property_offer_form_view" model="ir.ui.view">
        <field name="name">Estate Property Offer Form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="1">
                        <field name="price"/>
                        <field name="partner_id"/>
                        <field name="validity"/>
                        <field name="date_deadline"/>
                        <button name="action_accept" string="" type="object" icon="fa-check" invisible="status != 'pending'"/>
                        <button name="action_refuse" string="" type="object" icon="fa-times" invisible="status != 'pending'"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>